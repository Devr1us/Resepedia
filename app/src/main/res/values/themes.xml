<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Parent menggunakan Theme.Material3.DayNight.NoActionBar agar AppCompatActivity tidak crash -->
    <style name="Theme.Resepedia" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Pewarnaan status bar & navigation bar dikelola oleh enableEdgeToEdge() di Jetpack Compose -->
    </style>

    <!-- Tema Splash Screen Sistem (Android 12+) untuk Mode Terang -->
    <style name="Theme.Resepedia.Splash" parent="Theme.SplashScreen">
        <!-- Background warna terang selaras dengan CreamBackground di Jetpack Compose -->
        <item name="windowSplashScreenBackground">@color/splash_bg_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo_resepedia</item>
        <item name="postSplashScreenTheme">@style/Theme.Resepedia</item>
    </style>
</resources>
